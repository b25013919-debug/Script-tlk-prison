local function runIntro()
    local vp = getViewport()
    local intro = new("Frame", {
        Name = "Intro", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.white,
        BackgroundTransparency = 1, ZIndex = 10, Active = true,
    }, gui)
    local bgGrad = new("UIGradient", {
        Color = ColorSequence.new(Color3.fromRGB(18, 12, 36), Color3.fromRGB(8, 16, 32)), Rotation = 45,
    }, intro)
    tween(intro, 0.6, { BackgroundTransparency = 0 })
    TweenService:Create(bgGrad, TweenInfo.new(14, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1),
        { Rotation = 405 }):Play()

    -- Плавающие частицы на фоне
    task.spawn(function()
        local rng = Random.new()
        while Hub.Alive and intro.Parent do
            local size = rng:NextInteger(3, 8)
            local p = new("Frame", {
                Size = UDim2.fromOffset(size, size), Position = UDim2.new(rng:NextNumber(), 0, 1, 10),
                BackgroundColor3 = (rng:NextNumber() > 0.5) and C.accent or C.accent2,
                BackgroundTransparency = 0.6, ZIndex = 11,
            }, intro)
            corner(p, size)
            local dur = rng:NextNumber(5, 9)
            tween(p, dur, { Position = UDim2.new(p.Position.X.Scale, 0, -0.05, 0), BackgroundTransparency = 1 },
                Enum.EasingStyle.Linear)
            Debris:AddItem(p, dur + 0.3)
            task.wait(0.25)
        end
    end)

    local stage = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(560, 400), BackgroundTransparency = 1, ZIndex = 12,
    }, intro)
    new("UIScale", { Scale = math.clamp(math.min(vp.X * 0.95 / 560, vp.Y * 0.95 / 400), 0.5, 1.2) }, stage)

    -- ── Экран загрузки ──
    local brand = new("CanvasGroup", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 12,
    }, stage)

    local logo = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 72),
        Size = UDim2.fromOffset(0, 0), BackgroundColor3 = C.white,
    }, brand)
    corner(logo, 100)
    new("UIGradient", { Color = ColorSequence.new(C.accent, C.accent2), Rotation = 45 }, logo)
    local ring = stroke(logo, C.white, 3, 0.15)
    local ringGrad = new("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, C.accent2),
            ColorSequenceKeypoint.new(0.5, C.white),
            ColorSequenceKeypoint.new(1, C.accent2),
        }),
    }, ring)
    TweenService:Create(ringGrad, TweenInfo.new(2.5, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1),
        { Rotation = 360 }):Play()
    local letter = new("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "C",
        Font = FontK, TextSize = 54, TextColor3 = C.white, TextTransparency = 1,
    }, logo)
    tween(logo, 0.7, { Size = UDim2.fromOffset(92, 92) }, Enum.EasingStyle.Back)
    tween(letter, 0.6, { TextTransparency = 0 })

    local title = new("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 132), Size = UDim2.new(1, 0, 0, 64),
        BackgroundTransparency = 1, Text = "CLAUDE", Font = FontK, TextSize = 58,
        TextColor3 = C.white, MaxVisibleGraphemes = 0,
    }, brand)
    new("UIGradient", { Color = ColorSequence.new(C.accent, C.accent2) }, title)

    local subtitle = new("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 198), Size = UDim2.new(1, 0, 0, 22),
        BackgroundTransparency = 1, Text = "TLK PRISON EDITION", Font = FontM, TextSize = 16,
        TextColor3 = C.sub, TextTransparency = 1,
    }, brand)

    local status = new("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 252), Size = UDim2.new(1, 0, 0, 22),
        BackgroundTransparency = 1, Text = "Запуск...", Font = FontM, TextSize = 15, TextColor3 = C.text,
    }, brand)
    local barBg = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 286),
        Size = UDim2.fromOffset(380, 8), BackgroundColor3 = Color3.fromRGB(35, 35, 52),
    }, brand)
    corner(barBg, 4)
    local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.white }, barBg)
    corner(fill, 4)
    new("UIGradient", { Color = ColorSequence.new(C.accent, C.accent2) }, fill)
    local pct = new("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 302), Size = UDim2.new(1, 0, 0, 20),
        BackgroundTransparency = 1, Text = "0%", Font = FontB, TextSize = 14, TextColor3 = C.sub,
    }, brand)
    local info = new("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 340), Size = UDim2.new(1, 0, 0, 20),
        BackgroundTransparency = 1, Text = "", Font = FontM, TextSize = 13, TextColor3 = C.sub,
    }, brand)

    task.wait(0.7)
    for i = 1, 6 do
        title.MaxVisibleGraphemes = i
        task.wait(0.09)
    end
    title.MaxVisibleGraphemes = -1
    tween(subtitle, 0.5, { TextTransparency = 0 })
    task.wait(0.5)

    local shown = 0
    local function setProgress(target, text)
        status.Text = text
        tween(fill, 0.5, { Size = UDim2.new(target / 100, 0, 1, 0) })
        local from = shown
        for i = 1, 10 do
            shown = from + (target - from) * i / 10
            pct.Text = math.floor(shown + 0.5) .. "%"
            task.wait(0.05)
        end
    end

    -- Реальные проверки среды
    local exName = "Unknown"
    pcall(function() if identifyexecutor then exName = tostring((identifyexecutor())) end end)
    local funcs = {
        type(firetouchinterest) == "function",
        type(hookmetamethod) == "function",
        type(setclipboard) == "function",
    }
    local funcOk = 0
    for _, v in ipairs(funcs) do if v then funcOk += 1 end end
    local remOk = 0
    if getRemote("DashEvent") then remOk += 1 end
    if getRemote("Trail") then remOk += 1 end

    setProgress(15, "Проверка эксплоита: " .. exName)
    task.wait(0.25)
    setProgress(38, "Загрузка ассетов...")
    task.wait(0.25)
    setProgress(62, "Загрузка функций...")
    task.wait(0.25)
    setProgress(82, "Поиск ремоутов TLK Prison...")
    task.wait(0.25)
    setProgress(95, "Сборка интерфейса...")
    task.wait(0.2)
    setProgress(100, "Готово!")
    info.Text = "Функции: " .. funcOk .. "/3  |  Ремоуты: " .. remOk .. "/2"
    task.wait(0.8)

    tween(brand, 0.5, { GroupTransparency = 1 })
    task.wait(0.55)
    brand.Visible = false

    -- ── Выбор устройства ──
    local picker = new("CanvasGroup", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, GroupTransparency = 1, ZIndex = 12,
    }, stage)
    new("TextLabel", {
        Position = UDim2.new(0, 0, 0, 14), Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1,
        Text = "Выбери устройство", Font = FontK, TextSize = 32, TextColor3 = C.text,
    }, picker)
    new("TextLabel", {
        Position = UDim2.new(0, 0, 0, 56), Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1,
        Text = "Меню подстроится под твой экран", Font = FontM, TextSize = 15, TextColor3 = C.sub,
    }, picker)

    local chosen = nil
    local recommendPhone = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

    local function makeCard(xpos, kind, name, desc, recommended)
        local card = new("TextButton", {
            Position = UDim2.new(0, xpos, 0, 104), Size = UDim2.fromOffset(210, 236),
            BackgroundColor3 = C.panel, Text = "", AutoButtonColor = false,
        }, picker)
        corner(card, 16)
        local st = stroke(card, recommended and C.accent or C.off, 2, 0)
        local icon = new("Frame", {
            BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, 0, 0, 130),
        }, card)
        if kind == "phone" then drawPhone(icon) else drawPC(icon) end
        new("TextLabel", {
            Position = UDim2.new(0, 0, 0, 164), Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1,
            Text = name, Font = FontB, TextSize = 22, TextColor3 = C.text,
        }, card)
        new("TextLabel", {
            Position = UDim2.new(0, 0, 0, 194), Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1,
            Text = desc, Font = FontM, TextSize = 13, TextColor3 = C.sub,
        }, card)
        if recommended then
            local badge = new("TextLabel", {
                AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -10),
                Size = UDim2.fromOffset(140, 22), BackgroundColor3 = C.accent,
                Text = "ТВОЁ УСТРОЙСТВО", Font = FontB, TextSize = 12, TextColor3 = C.white, ZIndex = 3,
            }, card)
            corner(badge, 11)
        end
        card.MouseEnter:Connect(function()
            tween(st, 0.15, { Color = C.accent2 })
            tween(card, 0.15, { BackgroundColor3 = C.rowHover })
        end)
        card.MouseLeave:Connect(function()
            tween(st, 0.15, { Color = recommended and C.accent or C.off })
            tween(card, 0.15, { BackgroundColor3 = C.panel })
        end)
        card.Activated:Connect(function()
            if chosen then return end
            chosen = kind
            tween(card, 0.12, { Size = UDim2.fromOffset(200, 226) })
            tween(st, 0.12, { Color = C.good })
        end)
    end
    makeCard(50, "pc", "ПК", "Мышь и клавиатура", not recommendPhone)
    makeCard(300, "phone", "Телефон", "Крупные кнопки, сенсор", recommendPhone)

    tween(picker, 0.5, { GroupTransparency = 0 })
    repeat task.wait(0.05) until chosen or not Hub.Alive
    if not Hub.Alive then return end

    Hub.Device = chosen
    task.wait(0.25)
    tween(picker, 0.4, { GroupTransparency = 1 })
    task.wait(0.4)
    buildMain(chosen)
    tween(intro, 0.6, { BackgroundTransparency = 1 })
    task.wait(0.7)
    intro:Destroy()
end

-- Запуск (если интро упадёт — открываем меню сразу)
task.spawn(function()
    local ok, err = pcall(runIntro)
    if not ok then
        warn("[Claude] Ошибка интро: " .. tostring(err))
        if Hub.Alive then
            local dev = (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) and "phone" or "pc"
            local ok2, err2 = pcall(buildMain, dev)
            if not ok2 then warn("[Claude] Ошибка меню: " .. tostring(err2)) end
        end
    end
end)
