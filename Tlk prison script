--   КАЛИБРОВКА РЕМОУТОВ (авто-ловля RemoteEvent)
--   Один общий хук на __namecall, ставится один раз за сессию
-- ══════════════════════════════════════════════
local Cal = { mode = nil, onDone = nil, selfFire = false }
local Caught = { attack = nil, dash = nil, stamina = nil } -- { remote, args, slots }
local calToken = 0

local CAL_HINT = {
    attack = "Возьми оружие и УДАРЬ 1 РАЗ (лучше по игроку)",
    dash = "Сделай РЫВОК (Dash) 1 раз",
    stamina = "Побеги / сделай действие, которое тратит стамину",
}
local CAL_NAME = { attack = "Атака", dash = "Дэш", stamina = "Стамина" }

-- Служебные ремоуты, которые игнорируем при ловле
local BLACKLIST = { "trail", "chat", "analytic", "ping" }

-- Общий state живёт в getgenv, чтобы не плодить хуки при повторном запуске
local HookState = genv.ClaudeHookState
if not HookState then
    HookState = {}
    genv.ClaudeHookState = HookState
end
HookState.handler = nil

local function installHook()
    if HookState.installed then return true end
    local old
    local ok = pcall(function()
        local fn = function(self, ...)
            local h = HookState.handler
            if h then
                local method = getnamecallmethod()
                if method == "FireServer" then pcall(h, self, ...) end
            end
            return old(self, ...)
        end
        if newcclosure then fn = newcclosure(fn) end
        old = hookmetamethod(game, "__namecall", fn)
    end)
    if ok and old then HookState.installed = true end
    return HookState.installed == true
end

-- Ищем в аргументах цели (чужие персонажи), чтобы подставлять их при каждой атаке
local function detectSlots(args)
    local slots = {}
    for i = 1, args.n do
        local v = args[i]
        if typeof(v) == "Instance" then
            local model = v:IsA("Model") and v or v:FindFirstAncestorOfClass("Model")
            local owner = model and Players:GetPlayerFromCharacter(model)
            if owner and owner ~= LocalPlayer then
                local kind = v:IsA("Model") and "model" or (v:IsA("Humanoid") and "hum" or "part")
                slots[i] = { kind = kind, part = v.Name }
            end
        end
    end
    return slots
end

local function buildArgs(entry, targetChar)
    local a = table.clone(entry.args)
    if entry.slots and targetChar then
        for i, s in pairs(entry.slots) do
            if s.kind == "model" then
                a[i] = targetChar
            elseif s.kind == "hum" then
                a[i] = targetChar:FindFirstChildOfClass("Humanoid") or a[i]
            else
                a[i] = targetChar:FindFirstChild(s.part) or targetChar:FindFirstChild("HumanoidRootPart") or a[i]
            end
        end
    end
    return a
end

-- Отправка пойманного ремоута (с защитой, чтобы не ловить самих себя)
local function fireEntry(entry, targetChar)
    if not (entry and entry.remote and entry.remote.Parent) then return false end
    local a = buildArgs(entry, targetChar)
    Cal.selfFire = true
    local ok = pcall(function()
        entry.remote:FireServer(table.unpack(a, 1, a.n))
    end)
    Cal.selfFire = false
    return ok
end

-- Простая отправка ремоута без аргументов/с аргументами (тоже без самоловли)
local function safeFire(remote, ...)
    if not remote then return false end
    Cal.selfFire = true
    local args = table.pack(...)
    local ok = pcall(function() remote:FireServer(table.unpack(args, 1, args.n)) end)
    Cal.selfFire = false
    return ok
end

local function onFire(self, ...)
    local mode = Cal.mode
    if not mode or Cal.selfFire or not Hub.Alive then return end
    if typeof(self) ~= "Instance" or self.ClassName ~= "RemoteEvent" then return end
    local lname = self.Name:lower()
    for _, b in ipairs(BLACKLIST) do
        if lname:find(b, 1, true) then return end
    end
    if mode == "attack" and lname:find("dash", 1, true) then return end

    local args = table.pack(...)
    Cal.mode = nil
    local cb = Cal.onDone
    Cal.onDone = nil
    Caught[mode] = { remote = self, args = args, slots = (mode == "attack") and detectSlots(args) or nil }
    local rname = self.Name
    task.defer(function()
        notify(CAL_NAME[mode] .. ": поймано «" .. rname .. "»", C.good)
        if cb then cb(true) end
    end)
end
HookState.handler = onFire

local function startCalibration(mode, onDone)
    if not installHook() then
        notify("hookmetamethod не поддерживается этим эксплоитом", C.bad)
        if onDone then onDone(false) end
        return
    end
    -- Если уже идёт другая калибровка — отменяем её
    if Cal.mode and Cal.onDone then pcall(Cal.onDone, false) end
    calToken += 1
    local my = calToken
    Cal.mode = mode
    Cal.onDone = onDone
    notify(CAL_HINT[mode], C.accent2)
    task.delay(10, function()
        if Hub.Alive and Cal.mode == mode and calToken == my then
            Cal.mode = nil
            Cal.onDone = nil
            notify("Время вышло — действие не поймано", C.bad)
            if onDone then onDone(false) end
        end
    end)
end

