Hub.Cleanup = function()
    stopFly()
    local hum = getHum()
    if hum then
        hum.WalkSpeed = Orig.WalkSpeed
        hum.JumpPower = Orig.JumpPower
    end
    restoreHitboxes()
    clearESP()
    setFullbright(false)
    local cam = workspace.CurrentCamera
    if cam then cam.FieldOfView = Orig.FOV end
    if S.trail then applyTrails(false) end
end

Hub.Destroy = function()
    Hub.Alive = false
    Cal.mode = nil
    HookState.handler = nil
    for _, c in ipairs(Hub.Connections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(Hub.Connections)
    pcall(Hub.Cleanup)
    if Hub.Gui then pcall(function() Hub.Gui:Destroy() end) end
    if genv.ClaudeHub == Hub then genv.ClaudeHub = nil end
end

-- ══════════ Главный цикл (одно соединение на всё) ══════════
local timers = { kill = 0, stam = 0, stamR = 0, esp = 0, hit = 0, trail = 0, dash = 0, scan = 0, light = 0, cd = 0 }

track(RunService.Heartbeat:Connect(function(dt)
    if not Hub.Alive then return end
    local hum = getHum()
    if hum then
        if S.walk and hum.WalkSpeed ~= S.walkSpeed then hum.WalkSpeed = S.walkSpeed end
        if S.jump then
            hum.UseJumpPower = true
            if hum.JumpPower ~= S.jumpPower then hum.JumpPower = S.jumpPower end
        end
    end
    if S.fly then pcall(flyStep) end
    if S.fov then
        local cam = workspace.CurrentCamera
        if cam then cam.FieldOfView = S.fovValue end
    end
    for k in pairs(timers) do timers[k] += dt end

    -- Килл-аура: интервал зависит от режима (медленно / быстро / ultra)
    if S.kill and timers.kill >= KILL_INTERVALS[S.killMode] then
        timers.kill = 0
        pcall(killAuraStep)
    end

    -- Бесконечная стамина: локальные значения + пойманный ремоут
    if S.stamina then
        if timers.scan >= 2 then timers.scan = 0; pcall(scanStamina) end
        if timers.stam >= 0.1 then timers.stam = 0; pcall(staminaStep) end
        if Caught.stamina and timers.stamR >= 0.25 then
            timers.stamR = 0
            fireEntry(Caught.stamina)
        end
    end

    -- Бесконечный дэш: спам пойманного ремоута Dash
    if S.infDash and Caught.dash and timers.dash >= (S.dashMs / 1000) then
        timers.dash = 0
        fireEntry(Caught.dash)
    end

    -- NoCD на всём оружии
    if S.noCD and timers.cd >= 0.1 then
        timers.cd = 0
        pcall(removeToolCooldowns)
    end

    if timers.hit >= 0.5 then
        timers.hit = 0
        if S.hitbox or next(hbOriginal) then pcall(hitboxStep) end
    end
    if S.esp and timers.esp >= 0.3 then
        timers.esp = 0
        pcall(updateESP)
    end
    if S.trail and timers.trail >= 2 then
        timers.trail = 0
        pcall(applyTrails, true)
    end
    if S.fullbright and timers.light >= 1 then
        timers.light = 0
        setFullbright(true)
    end
end))

