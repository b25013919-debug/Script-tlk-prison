            Size = UDim2.new(1 / 3, -4, 1, 0), BackgroundColor3 = (mode == S.killMode) and C.accent or C.off,
            Text = label, Font = FontB, TextSize = TXT - 1, TextColor3 = C.white, AutoButtonColor = false,
        }, speedRow)
        corner(b, 10)
        b.Activated:Connect(function() selectSpeed(mode) end)
        speedBtns[mode] = b
    end

    section(pg, "ОРУЖИЕ")
    addToggle(pg, "NoCD на всём оружии", false, function(v)
        S.noCD = v
        notify(v and "NoCD вкл (серверные кулдауны это не снимает)" or "NoCD выключен", C.sub)
    end)
    addToggle(pg, "Трейл на ноже / бите", false, function(v)
        S.trail = v
        local n = applyTrails(v)
        if n == 0 then notify("Оружие с Trail не найдено", C.bad) else notify("Трейл: " .. n .. " шт.", C.good) end
    end)

    section(pg, "ХИТБОКС")
    addToggle(pg, "Большие хитбоксы врагов", false, function(v)
        S.hitbox = v
        if not v then restoreHitboxes() end
    end)
    addStepper(pg, "Размер хитбокса", 4, 25, 1, S.hitboxSize, function(v) S.hitboxSize = v end)

    -- ═════ Вкладка: Визуал ═════
    pg = pages[3]
    section(pg, "ВИЗУАЛ")
    addToggle(pg, "ESP игроков", false, function(v)
        S.esp = v
        if v then updateESP() else clearESP() end
    end)
    addToggle(pg, "Fullbright (без тьмы)", false, function(v)
        S.fullbright = v
        setFullbright(v)
    end)
    addToggle(pg, "Своё поле зрения (FOV)", false, function(v)
        S.fov = v
        if not v then
            local cam = workspace.CurrentCamera
            if cam then cam.FieldOfView = Orig.FOV end
        end
    end)
    addStepper(pg, "Значение FOV", 70, 120, 5, S.fovValue, function(v) S.fovValue = v end)

    -- ═════ Вкладка: Телепорт ═════
    pg = pages[4]
    section(pg, "БЫСТРЫЕ ДЕЙСТВИЯ")
    addButton(pg, "ТП к ближайшему игроку", function()
        local me = getRoot()
        if not me then notify("Персонаж не найден", C.bad) return end
        local best, bd = nil, math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            local r = plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if r then
                local d = (r.Position - me.Position).Magnitude
                if d < bd then best, bd = r, d end
            end
        end
        if best then
            me.CFrame = best.CFrame * CFrame.new(0, 0, 3)
            notify("Телепорт к ближайшему", C.good)
        else
            notify("Игроков нет", C.bad)
        end
    end)
    addButton(pg, "Сохранить позицию", function()
        local r = getRoot()
        if r then savedCFrame = r.CFrame; notify("Позиция сохранена", C.good) end
    end, C.accent2)
    addButton(pg, "Вернуться на позицию", function()
        local r = getRoot()
        if r and savedCFrame then r.CFrame = savedCFrame; notify("Вернулся", C.good)
        else notify("Позиция не сохранена", C.bad) end
    end, C.accent2)
    section(pg, "ИГРОКИ (нажми для ТП)")
    local listHolder = new("Frame", {
        Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
    }, pg)
    new("UIListLayout", { Padding = UDim.new(0, 6) }, listHolder)

    local function refreshPlayers()
        if not listHolder.Parent then return end
        for _, c in ipairs(listHolder:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local b = new("TextButton", {
                    Size = UDim2.new(1, 0, 0, BTN_H), BackgroundColor3 = C.row,
                    Text = "  " .. plr.DisplayName .. " (@" .. plr.Name .. ")",
                    Font = FontM, TextSize = TXT - 1, TextColor3 = C.text, TextXAlignment = Left,
                    AutoButtonColor = false, TextTruncate = Enum.TextTruncate.AtEnd,
                }, listHolder)
                corner(b, 10)
                b.Activated:Connect(function()
                    local r = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                    local me = getRoot()
                    if r and me then
                        me.CFrame = r.CFrame * CFrame.new(0, 0, 3)
                        notify("Телепорт к " .. plr.Name, C.good)
                    else
                        notify("Игрок недоступен", C.bad)
                    end
                end)
            end
        end
    end
    addButton(pg, "Обновить список", refreshPlayers, C.accent2)
    refreshPlayers()
    track(Players.PlayerAdded:Connect(function() task.wait(0.5); refreshPlayers() end))
    track(Players.PlayerRemoving:Connect(function() task.defer(refreshPlayers) end))

    -- ═════ Вкладка: Ремоуты (калибровка) ═════
    pg = pages[5]
    section(pg, "АВТО-ЛОВЛЯ REMOTEEVENT")
    addInfo(pg, "Нажми кнопку → в течение 10 сек сделай действие в игре → скрипт сам поймает RemoteEvent и будет использовать его.")
    calibButton(pg, "attack", "1. Откалибровать УДАР (возьми оружие)", "1. Удар пойман ✓ (перекалибровать)")
    calibButton(pg, "dash", "2. Откалибровать ДЭШ", "2. Дэш пойман ✓ (перекалибровать)")
    calibButton(pg, "stamina", "3. Откалибровать СТАМИНУ (побегай)", "3. Стамина поймана ✓ (перекалибровать)")
    section(pg, "СТАТУС")
    local statusLbl = addInfo(pg, "")
    local function refreshStatus()
        local function st(mode)
            local e = Caught[mode]
            return e and ("✓ " .. e.remote.Name) or "— не поймано"
        end
        statusLbl.Text = "Удар: " .. st("attack") .. "\nДэш: " .. st("dash") .. "\nСтамина: " .. st("stamina")
    end
    refreshStatus()
    task.spawn(function()
        while Hub.Alive and statusLbl.Parent do
            refreshStatus()
            task.wait(1)
        end
    end)
    addButton(pg, "Сбросить пойманное", function()
        Caught.attack, Caught.stamina = nil, nil
        local d = getRemote("DashEvent")
        Caught.dash = d and { remote = d, args = table.pack() } or nil
        refreshStatus()
        notify("Калибровка сброшена", C.sub)
    end, C.off)

    -- ═════ Вкладка: Прочее ═════
    pg = pages[6]
    section(pg, "СИСТЕМА")
    addToggle(pg, "Анти-АФК", true, function(v) S.antiAfk = v end)
    addButton(pg, "Скопировать PlaceId", function()
        if setclipboard then
            setclipboard(tostring(game.PlaceId))
            notify("PlaceId скопирован", C.good)
        else
            notify("setclipboard не поддерживается", C.bad)
        end
    end, C.accent2)
    addButton(pg, "Перезайти на сервер (Rejoin)", function()
        notify("Перезаход...")
        pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
    end, C.accent2)
    local exName = "Unknown"
    pcall(function() if identifyexecutor then exName = tostring((identifyexecutor())) end end)
    addInfo(pg, "Эксплоит: " .. exName .. " | Устройство: " .. (isPhone and "Телефон" or "ПК")
        .. (isPhone and "" or " | RightShift — скрыть меню"))
    addButton(pg, "Выгрузить скрипт", function() Hub.Destroy() end, C.bad)

    -- Запуск: открываем окно
    selectTab(1)
    showWindow(true)
    notify("Claude Hub загружен. Кнопка «C» — скрыть/показать меню", C.good)
end

