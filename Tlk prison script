-- ══════════ Полёт ══════════
local function stopFly()
    if fly.bv then pcall(function() fly.bv:Destroy() end); fly.bv = nil end
    if fly.bg then pcall(function() fly.bg:Destroy() end); fly.bg = nil end
    local hum = getHum()
    if hum then hum.PlatformStand = false end
end

local function flyStep()
    local root, hum = getRoot(), getHum()
    local cam = workspace.CurrentCamera
    if not (root and hum and cam) then return end
    if not fly.bv or fly.bv.Parent ~= root then
        stopFly()
        fly.bv = new("BodyVelocity", { MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero }, root)
        fly.bg = new("BodyGyro", { MaxTorque = Vector3.new(1e9, 1e9, 1e9), P = 9e4, CFrame = root.CFrame }, root)
    end
    hum.PlatformStand = true
    local md = hum.MoveDirection
    local look = cam.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    local fwd = 0
    if md.Magnitude > 0 and flat.Magnitude > 0 then fwd = flat.Unit:Dot(md) end
    -- Смотришь вверх + двигаешь джойстик вперёд = летишь вверх
    local vel = md * S.flySpeed + Vector3.new(0, look.Y * fwd * S.flySpeed, 0)
    if fly.up then vel += Vector3.new(0, S.flySpeed, 0) end
    if fly.down then vel -= Vector3.new(0, S.flySpeed, 0) end
    fly.bv.Velocity = vel
    if flat.Magnitude > 0 then
        fly.bg.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
    end
end

-- ══════════ Стамина (локальные значения) ══════════
local staminaTargets = {}

local function findMax(t)
    if t.attr then
        for n, v in pairs(t.inst:GetAttributes()) do
            local l = n:lower()
            if type(v) == "number" and l:find("stamina") and l:find("max") then return v end
        end
    elseif t.inst.Parent then
        for _, s in ipairs(t.inst.Parent:GetChildren()) do
            local l = s.Name:lower()
            if (s:IsA("NumberValue") or s:IsA("IntValue")) and l:find("stamina") and l:find("max") then
                return s.Value
            end
        end
    end
    return nil
end

local function scanStamina()
    local found = {}
    local roots = { LocalPlayer }
    if LocalPlayer.Character then table.insert(roots, LocalPlayer.Character) end
    for _, r in ipairs(roots) do
        for _, d in ipairs(r:GetDescendants()) do
            if d:IsA("NumberValue") or d:IsA("IntValue") then
                local n = d.Name:lower()
                if n:find("stamina") and not n:find("max") then
                    table.insert(found, { inst = d, peak = d.Value })
                end
            end
        end
        for name, val in pairs(r:GetAttributes()) do
            local l = name:lower()
            if type(val) == "number" and l:find("stamina") and not l:find("max") then
                table.insert(found, { inst = r, attr = name, peak = val })
            end
        end
    end
    staminaTargets = found
    return #found
end

local function staminaStep()
    for _, t in ipairs(staminaTargets) do
        if t.inst and t.inst.Parent then
            local cur = t.attr and t.inst:GetAttribute(t.attr) or t.inst.Value
            if type(cur) == "number" then
                t.peak = math.max(t.peak or 0, cur)
                local goal = findMax(t)
                if not goal then
                    goal = (t.peak <= 1) and 1 or math.max(t.peak, 100)
                end
                if cur < goal then
                    if t.attr then t.inst:SetAttribute(t.attr, goal) else t.inst.Value = goal end
                end
            end
        end
    end
end

-- ══════════ Трейл оружия (нож / бита) ══════════
local function applyTrails(state)
    local remote = getRemote("Trail")
    if not remote then return 0 end
    local n = 0
    local containers = { LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character }
    for _, container in ipairs(containers) do
        if container then
            for _, tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") then
                    local trail = tool:FindFirstChild("Trail")
                    if trail then
                        safeFire(remote, trail, state)
                        n += 1
                    end
                end
            end
        end
    end
    return n
end

-- ══════════ NoCD: сброс клиентских кулдаунов на всём оружии ══════════
local function removeToolCooldowns()
    local containers = { LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character }
    for _, container in ipairs(containers) do
        if container then
            for _, tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") then
                    pcall(function() tool.Enabled = true end)
                    for _, d in ipairs(tool:GetDescendants()) do
                        local n = d.Name:lower()
                        if n:find("debounce") or n:find("cooldown") or n == "cd" then
                            if d:IsA("BoolValue") then pcall(function() d.Value = false end) end
                            if d:IsA("NumberValue") or d:IsA("IntValue") then pcall(function() d.Value = 0 end) end
                        end
                    end
                    for attr, val in pairs(tool:GetAttributes()) do
                        local a = attr:lower()
                        if a:find("cooldown") or a:find("debounce") then
                            if typeof(val) == "boolean" then pcall(function() tool:SetAttribute(attr, false) end)
                            elseif typeof(val) == "number" then pcall(function() tool:SetAttribute(attr, 0) end) end
                        end
                    end
                end
            end
        end
    end
end

-- ══════════ Килл-аура (любое оружие + пойманный ремоут атаки) ══════════
local function killAuraStep()
    local char = LocalPlayer.Character
    local root = getRoot()
    local hum = getHum()
    if not (char and root and hum) then return end

    local tool = char:FindFirstChildOfClass("Tool")
    -- Если в руках пусто — берём первое оружие из рюкзака
    if not tool and S.autoEquip then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        local t = bp and bp:FindFirstChildOfClass("Tool")
        if t then
            pcall(function() hum:EquipTool(t) end)
            tool = t
        end
    end
    local handle = tool and (tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart"))

    local hits = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if hits >= 5 then break end
        if plr ~= LocalPlayer and isEnemy(plr) then
            local c = plr.Character
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            local eh = c and c:FindFirstChildOfClass("Humanoid")
            if hrp and eh and eh.Health > 0
                and (hrp.Position - root.Position).Magnitude <= S.killRange then
                hits += 1
                if tool and tool.Parent == char then pcall(function() tool:Activate() end) end
                if handle and firetouchinterest then
                    pcall(function()
                        firetouchinterest(handle, hrp, 0)
                        firetouchinterest(handle, hrp, 1)
                    end)
                end
                if Caught.attack then fireEntry(Caught.attack, c) end
            end
        end
    end
end

-- ══════════ Хитбоксы ══════════
local function restoreHitboxes()
    for part, size in pairs(hbOriginal) do
        if part and part.Parent then
            pcall(function() part.Size = size; part.Transparency = 1 end)
        end
    end
    table.clear(hbOriginal)
end

local function hitboxStep()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                if S.hitbox and isEnemy(plr) then
                    if not hbOriginal[hrp] then hbOriginal[hrp] = hrp.Size end
                    local s = S.hitboxSize
                    hrp.Size = Vector3.new(s, s, s)
                    hrp.Transparency = 0.8
                    hrp.CanCollide = false
                elseif hbOriginal[hrp] then
                    hrp.Size = hbOriginal[hrp]
                    hrp.Transparency = 1
                    hbOriginal[hrp] = nil
                end
            end
        end
    end
end

-- ══════════ ESP ══════════
local function clearESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        local c = plr.Character
        if c then
            local h = c:FindFirstChild("ClaudeESP")
            if h then h:Destroy() end
            local head = c:FindFirstChild("Head")
            local b = head and head:FindFirstChild("ClaudeTag")
            if b then b:Destroy() end
        end
    end
end

local function updateESP()
    local myRoot = getRoot()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local head = char and char:FindFirstChild("Head")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if char and head and root then
                local color = (plr.Team and plr.TeamColor.Color) or Color3.fromRGB(255, 80, 80)
                local hl = char:FindFirstChild("ClaudeESP")
                if not hl then
                    hl = new("Highlight", {
                        Name = "ClaudeESP", FillTransparency = 0.6, OutlineTransparency = 0,
                        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Adornee = char,
                    }, char)
                end
                hl.FillColor = color
                hl.OutlineColor = C.white
                local tag = head:FindFirstChild("ClaudeTag")
                if not tag then
                    tag = new("BillboardGui", {
                        Name = "ClaudeTag", Size = UDim2.fromOffset(150, 34),
                        StudsOffset = Vector3.new(0, 2.6, 0), AlwaysOnTop = true,
                    }, head)
                    new("TextLabel", {
                        Name = "L", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
                        Font = FontB, TextSize = 14, TextColor3 = C.white, TextStrokeTransparency = 0.4,
                    }, tag)
                end
                local lbl = tag:FindFirstChild("L")
                if lbl then
                    local dist = myRoot and math.floor((root.Position - myRoot.Position).Magnitude) or 0
                    lbl.Text = plr.DisplayName .. "\n[" .. dist .. "m]"
                    lbl.TextColor3 = color
                end
            end
        end
    end
